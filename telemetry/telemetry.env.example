# The collector's systemd EnvironmentFile, mode 0600. Never commit real credentials.
# Every value below is a placeholder; config.alloy reads each one with sys.env.
# Host name stamped on every record (host.name, the Loki host label, the Alloy instance).
BATON_TELEMETRY_HOST=agent-host
BATON_LOKI_PUSH_URL=https://loki.example.com/loki/api/v1/push
BATON_TEMPO_OTLP_URL=https://tempo.example.com
BATON_PROM_REMOTE_WRITE_URL=https://prometheus.example.com/api/v1/write
BATON_PROM_REMOTE_WRITE_USER=agent-telemetry
BATON_PROM_REMOTE_WRITE_PASSWORD=REPLACE_WITH_DEDICATED_CREDENTIAL
# CA bundle for the three backends; leave empty to use the system trust store.
BATON_TELEMETRY_CA_FILE=
