      `set(cache["safe"]["runs"], attributes["runs"]) where attributes["runs"] != nil`,
      `set(cache["safe"]["incomplete_runs"], attributes["incomplete_runs"]) where attributes["incomplete_runs"] != nil`,
      `set(cache["safe"]["review_rounds"], attributes["review_rounds"]) where attributes["review_rounds"] != nil`,
      `set(cache["safe"]["spec_rounds"], attributes["spec_rounds"]) where attributes["spec_rounds"] != nil`,
      `set(cache["safe"]["requested_model"], attributes["requested_model"]) where attributes["requested_model"] != nil`,
      `set(cache["safe"]["actual_model"], attributes["actual_model"]) where attributes["actual_model"] != nil`,
      `set(cache["safe"]["elapsed_ms"], attributes["elapsed_ms"]) where attributes["elapsed_ms"] != nil`,
      `set(cache["safe"]["active_ms"], attributes["active_ms"]) where attributes["active_ms"] != nil`,
      `set(cache["safe"]["last_attempt_ms"], attributes["last_attempt_ms"]) where attributes["last_attempt_ms"] != nil`,
      `set(cache["safe"]["model_ms"], attributes["model_ms"]) where attributes["model_ms"] != nil`,
