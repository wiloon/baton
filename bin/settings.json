{
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "off", "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off", "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off", "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off", "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off", "anthropic-skills:pdf": "off", "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off", "anthropic-skills:xlsx": "off",
    "omarchy": "off", "diagnose-crash": "off", "design": "off", "plugin-authoring": "off"
  },
  "enabledPlugins": { "engineering@synced": false },
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write", "NotebookEdit",
      "Skill", "TodoWrite", "Agent", "WebSearch", "WebFetch",
      "Bash(git *)", "Bash(gh *)",
      "Bash(go *)", "Bash(gofmt *)", "Bash(golangci-lint *)",
      "Bash(pnpm *)", "Bash(npx *)", "Bash(node *)", "Bash(corepack *)",
      "Bash(task *)", "Bash(mise *)", "Bash(xvfb-run *)",
      "Bash(ls *)", "Bash(ls)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)",
      "Bash(grep *)", "Bash(rg *)", "Bash(find *)", "Bash(sed *)", "Bash(awk *)", "Bash(jq *)",
      "Bash(sort *)", "Bash(uniq *)", "Bash(diff *)", "Bash(cut *)", "Bash(tr *)", "Bash(xargs *)",
      "Bash(mkdir *)", "Bash(cp *)", "Bash(mv *)", "Bash(rm *)", "Bash(touch *)",
      "Bash(echo *)", "Bash(printf *)", "Bash(pwd)", "Bash(cd *)", "Bash(test *)", "Bash(which *)",
      "Bash(basename *)", "Bash(dirname *)", "Bash(date *)", "Bash(sqlite3 *)", "Bash(timeout *)",
      "Bash(curl http://localhost*)", "Bash(curl -s http://localhost*)",
      "Bash(*/baton/hooks/e2e.sh *)", "Bash(*/baton/hooks/e2e-homelab.sh *)"
    ],
    "deny": [
      "CronCreate", "CronDelete", "CronList", "ScheduleWakeup", "RemoteTrigger", "PushNotification", "SendMessage", "ListAgents", "DesignSync", "EnterWorktree", "ExitWorktree",
      "Read(~/.config/baton/**)", "Read(~/.config/gh/**)", "Read(~/.ssh/**)",
      "Bash(git tag *)", "Bash(git push --tags*)", "Bash(git push --force *)",
      "Bash(gh release *)", "Bash(gh workflow *)", "Bash(gh api *)", "Bash(gh auth *)",
      "Bash(kubectl *)", "Bash(ssh *)", "Bash(task deploy*)", "Bash(env)", "Bash(printenv*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$HOME/baton/bin/guard.sh" }
        ]
      }
    ]
  }
}
